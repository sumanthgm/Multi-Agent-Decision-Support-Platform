{
  "version": "0.2.0",
  "configurations": [
    {"name": "Tests (pytest)", "type": "debugpy", "request": "launch", "module": "pytest", "args": ["-q"], "cwd": "${workspaceFolder}", "env": {"PYTHONPATH": "${workspaceFolder}/src"}},
    {"name": "E1-E4: experiments (quick)", "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/scripts/run_experiments.py", "args": ["--quick"], "cwd": "${workspaceFolder}", "env": {"PYTHONPATH": "${workspaceFolder}/src"}},
    {"name": "E1-E4: experiments (full)", "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/scripts/run_experiments.py", "cwd": "${workspaceFolder}", "env": {"PYTHONPATH": "${workspaceFolder}/src"}},
    {"name": "E5: prepare PMSM real-fault data", "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/scripts/prepare_pmsm.py", "cwd": "${workspaceFolder}", "env": {"PYTHONPATH": "${workspaceFolder}/src"}},
    {"name": "E5: validate on real faults", "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/scripts/validate_real.py", "args": ["--csv", "data/real/pmsm_10hz.csv", "--split", "blocks", "--window", "20", "--signals", "Ia", "Ib", "VDC", "IDC", "VD", "--labels", "F0", "F1", "F2", "F3", "F4", "F5", "--out", "results/real_faults", "--tag", "electrical_window"], "cwd": "${workspaceFolder}", "env": {"PYTHONPATH": "${workspaceFolder}/src"}},
    {"name": "E6: prepare La Reunion weather", "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/scripts/prepare_reunion_weather.py", "cwd": "${workspaceFolder}", "env": {"PYTHONPATH": "${workspaceFolder}/src"}},
    {"name": "E6: experiments with real weather", "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/scripts/run_experiments.py", "args": ["--weather", "data/real/reunion_weather_1min.csv", "--out", "results/real_weather"], "cwd": "${workspaceFolder}", "env": {"PYTHONPATH": "${workspaceFolder}/src"}},
    {"name": "Train live inverter model", "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/scripts/train.py", "args": ["--profile", "inverter_hybrid_5kw"], "cwd": "${workspaceFolder}", "env": {"PYTHONPATH": "${workspaceFolder}/src"}},
    {"name": "Train live pump-drive model", "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/scripts/train.py", "args": ["--profile", "pump_drive_5hp"], "cwd": "${workspaceFolder}", "env": {"PYTHONPATH": "${workspaceFolder}/src"}},
    {"name": "Live: API (FastAPI)", "type": "debugpy", "request": "launch", "module": "uvicorn", "args": ["pdm.serve.api:app", "--port", "8000"], "cwd": "${workspaceFolder}", "env": {"PYTHONPATH": "${workspaceFolder}/src", "PDM_PROFILE": "inverter_hybrid_10kw"}},
    {"name": "Live: API with real weather", "type": "debugpy", "request": "launch", "module": "uvicorn", "args": ["pdm.serve.api:app", "--port", "8000"], "cwd": "${workspaceFolder}", "env": {"PYTHONPATH": "${workspaceFolder}/src", "PDM_PROFILE": "inverter_hybrid_10kw", "PDM_WEATHER": "data/real/reunion_weather_1min.csv"}},
    {"name": "Live: dashboard (Streamlit)", "type": "debugpy", "request": "launch", "module": "streamlit", "args": ["run", "app/dashboard.py"], "cwd": "${workspaceFolder}"},
    {"name": "Live: replay to API", "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/scripts/replay.py", "args": ["--profile", "inverter_hybrid_10kw", "--mode", "api", "--speed", "50"], "cwd": "${workspaceFolder}", "env": {"PYTHONPATH": "${workspaceFolder}/src"}},
    {"name": "Live: replay in console", "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/scripts/replay.py", "args": ["--profile", "pump_drive_3hp", "--mode", "local"], "cwd": "${workspaceFolder}", "env": {"PYTHONPATH": "${workspaceFolder}/src"}}
  ]
}
